PORT=3000
# interface to listen on: keep 127.0.0.1 behind Nginx, never expose the app directly
HOST=127.0.0.1
# max photo size in MB (Nginx client_max_body_size must be slightly higher)
MAX_UPLOAD_MB=5
MONGODB_URL=mongodb://localhost:27017/locoxpatentes
# database used by `npm test`: it is wiped between tests, never point it at the real one
TEST_MONGODB_URL=mongodb://localhost:27017/locoxpatentes-test
# key used to sign the JWTs: use a long random string (e.g. `openssl rand -hex 48`)
SECRET=change-me
